# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Telegram bot: the token from @BotFather, and a random string of your own that
# Telegram sends back with every webhook call (letters, digits, _ and - only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Eskiz.uz SMS. ESKIZ_SENDER is your approved sender name; empty uses 4546
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=

# Scheduled jobs and app. CRON_SECRET is a random string; store the same value
# and APP_URL in Supabase Vault as 'cron_secret' and 'app_url'. APP_URL is also
# where "Open in CRM" in a staff lead alert on Telegram leads (https://...)
CRON_SECRET=
APP_URL=

# Public lead forms. FORMS_HOST is the address forms are served on, without
# https:// (e.g. forms.yourcentre.uz); add the same domain to the Vercel project.
# FORM_SIGNING_SECRET is a long random string of your own (openssl rand -hex 32)
FORMS_HOST=
FORM_SIGNING_SECRET=

# Facebook and Instagram lead ads (docs/META_SETUP.md). The app id and secret
# are from the Meta app's Basic settings; the verify token is a random string of
# your own, typed again in the Meta app's Webhooks settings. The Page's access
# token is not set here: it is stored in Supabase Vault when the owner connects.
# META_GRAPH_VERSION is optional (default v23.0)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=

# Student app (docs/STUDENT_APP_SPEC.md). SEND_SMS_HOOK_SECRET is the secret
# Supabase shows for the Send SMS hook (v1,whsec_...); the hook's address is
# https://<your CRM domain>/api/auth/send-sms. FIREBASE_SERVICE_ACCOUNT is the
# Firebase service account key for push: the downloaded JSON on one line, or
# the same JSON base64-encoded. APP_STORE_URL and GOOGLE_PLAY_URL are the
# store links "Send app invite" puts in its SMS; at least one must be set
SEND_SMS_HOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT=
APP_STORE_URL=
GOOGLE_PLAY_URL=
