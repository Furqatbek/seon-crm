# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Telegram bot: the token from @BotFather, and a random string of your own that
# Telegram sends back with every webhook call (letters, digits, _ and - only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Eskiz.uz SMS. ESKIZ_SENDER is your approved sender name; empty uses 4546
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=

# Scheduled jobs and app. CRON_SECRET is a random string; store the same value
# and APP_URL in Supabase Vault as 'cron_secret' and 'app_url'
CRON_SECRET=
APP_URL=
